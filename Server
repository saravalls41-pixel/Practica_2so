#include <errno.h>
#include <fcntl.h>
#include <netinet/in.h>
#include <signal.h>
#include <stdio.h>
#include <sys/socket.h>
#include <unistd.h>

#define KTAM 20
#define KPUERTO 9999

static int enviar_archivo(int conexion)
{
    int archivo = open("Google.html", O_RDONLY);
    if (archivo < 0) {
        perror("Google.html");
        return 1;
    }

    char buffer[KTAM];
    ssize_t leidos;

    while ((leidos = read(archivo, buffer, sizeof buffer)) > 0) {
        ssize_t enviados = 0;

        while (enviados < leidos) {
            ssize_t escritos = write(conexion, buffer + enviados,
                                     leidos - enviados);

            if (escritos < 0 && errno == EINTR)
                continue;

            if (escritos <= 0) {
                perror("write");
                close(archivo);
                return 1;
            }

            enviados += escritos;
        }
    }

    if (leidos < 0)
        perror("read");

    close(archivo);
    return leidos < 0;
}

int main(void)
{
    int escucha = socket(AF_INET, SOCK_STREAM, 0);
    if (escucha < 0) {
        perror("socket");
        return 1;
    }

    int opcion = 1;
    setsockopt(escucha, SOL_SOCKET, SO_REUSEADDR,
               &opcion, sizeof opcion);

    struct sockaddr_in servidor = {0};
    servidor.sin_family = AF_INET;
    servidor.sin_port = htons(KPUERTO);
    servidor.sin_addr.s_addr = htonl(INADDR_ANY);

    if (bind(escucha, (struct sockaddr *)&servidor,
             sizeof servidor) < 0) {
        perror("bind");
        close(escucha);
        return 1;
    }

    if (listen(escucha, 5) < 0) {
        perror("listen");
        close(escucha);
        return 1;
    }

    signal(SIGCHLD, SIG_IGN);
    signal(SIGPIPE, SIG_IGN);

    printf("Servidor escuchando en el puerto %d\n", KPUERTO);
    fflush(stdout);

    for (;;) {
        int conexion = accept(escucha, NULL, NULL);

        if (conexion < 0) {
            if (errno == EINTR)
                continue;

            perror("accept");
            close(escucha);
            return 1;
        }

        printf("Aceptando conexion\n");
        fflush(stdout);

        pid_t pid = fork();

        if (pid == 0) {
            close(escucha);

            printf("Hijo %ld: enviando Google.html\n",
                   (long)getpid());
            fflush(stdout);

            int resultado = enviar_archivo(conexion);

            if (resultado == 0)
                printf("Hijo %ld: transferencia terminada\n",
                       (long)getpid());
            else
                printf("Hijo %ld: error en la transferencia\n",
                       (long)getpid());

            fflush(stdout);
            close(conexion);
            _exit(resultado);
        }

        if (pid < 0)
            perror("fork");

        close(conexion);
    }
}
